APP_NAME="AI Agent Knowledge Workspace"
APP_VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG=false

# Supabase Postgres / pgvector
# Copy the connection string from Supabase Dashboard -> Connect.
# Recommended for cloud deployment: use the Session Pooler URI.
#
# Example shape:
# DATABASE_URL="postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
DATABASE_URL=""

# Use the Redis URL from your deployment platform, for example Railway Redis.
REDIS_URL=""

LLM_API_KEY=""
LLM_BASE_URL=""
LLM_CHAT_MODEL=""

EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="deterministic-test-embedding"
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=64

LOG_LEVEL="INFO"
LOG_TO_FILE=false
LOG_FILE_PATH="logs/app.log"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
